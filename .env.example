# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173

# Auth - replace both before any deployment
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Storage. Leave MONGODB_URI empty to use the JSON-file development repository.
MONGODB_URI=
MONGODB_DB=make_it_ai
REDIS_URL=

# AI providers - never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_FALLBACK_ORDER=openai,anthropic,gemini,local-rules

# GitHub integration (user-supplied token, permission-scoped)
GITHUB_TOKEN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
