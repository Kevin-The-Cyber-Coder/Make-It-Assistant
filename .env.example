# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173

# Auth - replace both before any deployment
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Storage. Leave MONGODB_URI empty to use the JSON-file development repository.
MONGODB_URI=
MONGODB_DB=make_it_ai

# Redis. Leave empty to use in-process rate limiting and task queues.
REDIS_URL=

# AI providers - never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_FALLBACK_ORDER=openai,anthropic,gemini,local-rules

# GitHub integration (user-supplied token, permission-scoped)
GITHUB_TOKEN=

# GitHub OAuth app. Register the callback URL with GitHub exactly as written here.
# Leave all three empty to disable the browser flow and use the token field or GITHUB_TOKEN.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/github/oauth/callback
GITHUB_OAUTH_SCOPES=repo,read:user
GITHUB_OAUTH_COOKIE_SAMESITE=lax

# Live dependency advisories. OSV is a public API; disabled by default.
OSV_ENABLED=false
OSV_API_URL=https://api.osv.dev
OSV_TIMEOUT_MS=8000
OSV_MAX_PACKAGES=100

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Isolated sandbox worker. Leave SANDBOX_URL empty to keep execution disabled.
SANDBOX_URL=
SANDBOX_TOKEN=
SANDBOX_TIMEOUT_MS=120000
WORKER_PORT=4100
SANDBOX_ALLOWED_COMMANDS=node --version,npm --version,npm test,npm run typecheck,npm run build,vitest run
SANDBOX_BIN_DIR=./node_modules/.bin
