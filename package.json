{
  "name": "make-it-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MAKE IT AI - an AI-powered software engineering and defensive cybersecurity agentic platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @make-it-ai/api",
    "dev:web": "npm run dev --workspace @make-it-ai/web",
    "start": "npm run start --workspace @make-it-ai/api",
    "build": "npm run build --workspace @make-it-ai/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run apps/api/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx || true",
    "format": "prettier --write .",
    "format:check": "prettier --check apps packages scripts docs README.md",
    "compliance": "node scripts/compliance-report.mjs",
    "db:up": "docker compose up -d mongo redis",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.68.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rollup": "npm:@rollup/wasm-node@4.68.7",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
