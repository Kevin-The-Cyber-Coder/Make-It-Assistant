{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@make-it-ai/shared": ["packages/shared/src"],
      "@make-it-ai/database": ["packages/database/src"],
      "@make-it-ai/ai-gateway": ["packages/ai-gateway/src"],
      "@make-it-ai/agents": ["packages/agents/src"],
      "@make-it-ai/project-intelligence": ["packages/project-intelligence/src"],
      "@make-it-ai/security-engine": ["packages/security-engine/src"],
      "@make-it-ai/dev-engine": ["packages/dev-engine/src"],
      "@make-it-ai/github-integration": ["packages/github-integration/src"],
      "@/*": ["apps/web/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/api/tests/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "tools", "dist", ".data"]
}
